# Server
PORT=3000

# Database (docker-compose exposes postgres on host port 5433)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=buddyscript
POSTGRES_PASSWORD=buddyscript
POSTGRES_DB=buddyscript

# Auth — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Set to "production" on the live server so cookies are Secure
NODE_ENV=development

# Image storage (optional). Set your Cloudinary URL to store post images in
# Cloudinary — required on hosts with ephemeral filesystems like Render.
# Leave empty to store images on local disk under backend/uploads.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
